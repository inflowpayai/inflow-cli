{
  "name": "@inflowpayai/inflow-core",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Typed HTTP client and resource interfaces for InFlow. Workspace-internal.",
  "homepage": "https://github.com/inflowpayai/inflow-cli#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "clean": "rm -rf dist .turbo"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inflowpayai/inflow-cli.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/inflowpayai/inflow-cli/issues"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "strip-ansi": "^7.2.0",
    "undici": "7.18.2"
  },
  "peerDependencies": {
    "@aep-foundation/agent": "^0.3.2",
    "@inflowpayai/mpp": "^0.8.0",
    "@inflowpayai/mpp-buyer": "^0.7.0",
    "@inflowpayai/x402": "^0.9.0",
    "@inflowpayai/x402-buyer": "^0.8.0",
    "@offering-protocol/agent": "^0.3.0",
    "@offering-protocol/core": "^0.3.1",
    "@offering-protocol/directory": "^0.2.3",
    "@x402/core": "^2.22.0"
  },
  "devDependencies": {
    "@aep-foundation/agent": "^0.3.2",
    "@inflowpayai/mpp": "^0.8.0",
    "@inflowpayai/mpp-buyer": "^0.7.0",
    "@inflowpayai/x402": "^0.9.0",
    "@inflowpayai/x402-buyer": "^0.8.0",
    "@offering-protocol/agent": "^0.3.0",
    "@offering-protocol/core": "^0.3.1",
    "@offering-protocol/directory": "^0.2.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@x402/core": "^2.22.0"
  }
}
